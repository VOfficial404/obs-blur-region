autoload -Uz log_error log_status log_info log_warning mkcd

if (( ! ${+project_root} )) {
  log_error "'project_root' not set. Please set before running ${0}."
  return 2
}

if (( ! ${+target} )) {
  log_error "'target' not set. Please set before running ${0}."
  return 2
}

pushd ${project_root}

local -a apt_args=(
  ${CI:+-y}
  --no-install-recommends
)
if (( _loglevel == 0 )) apt_args+=(--quiet)

if (( ! (${skips[(Ie)all]} + ${skips[(Ie)deps]}) )) {
  log_group 'Installing obs-studio build dependencies...'

  local suffix
  if [[ ${CPUTYPE} != "${target##*-}" ]] {
    local -A arch_mappings=(
      aarch64 arm64
      x86_64 amd64
    )

    suffix=":${arch_mappings[${target##*-}]}"

    sudo apt-get install ${apt_args} gcc-${${target##*-}//_/-}-linux-gnu g++-${${target##*-}//_/-}-linux-gnu
  }

  # Retry transient mirror failures instead of failing the whole job.
  print 'Acquire::Retries "5";' | sudo tee /etc/apt/apt.conf.d/80-retries > /dev/null

  local -a _build_packages=(build-essential libgles2-mesa-dev libsimde-dev)

  # obs-studio comes from the GitHub release matching buildspec.json: it is the same package the
  # obsproject PPA ships, but Launchpad often answers 503. The PPA stays as the fallback.
  # The .deb is installed with root rights, so only a package whose SHA-256 is pinned here is used.
  local -A obs_deb_sha256=(
    obs-studio_31.1.1-0obsproject1.noble_amd64.deb 4d6c44540c73e937e23cf47ef180d0ef825fbfb63755866f377aa63b9eb8e7be
  )
  local obs_version="$(jq -r '.dependencies["obs-studio"].version' ${project_root}/buildspec.json)"
  local obs_deb="${project_root}/.deps/obs-studio_${obs_version}-0obsproject1.$(lsb_release -cs)_amd64.deb"
  mkdir -p ${obs_deb:h}

  if [[ -z ${suffix} && -n ${obs_deb_sha256[${obs_deb:t}]} ]] && \
    curl --fail --silent --show-error --location --retry 5 --retry-all-errors \
    --output ${obs_deb} \
    "https://github.com/obsproject/obs-studio/releases/download/${obs_version}/${obs_deb:t}" && \
    print "${obs_deb_sha256[${obs_deb:t}]}  ${obs_deb}" | sha256sum --check --quiet
  then
    sudo apt-get update
    sudo apt-get install ${apt_args} ${_build_packages} ${obs_deb}
  else
    log_warning "No obs-studio ${obs_version} package on GitHub for this system, using the obsproject PPA"
    local attempt
    for attempt ({1..5}) {
      sudo add-apt-repository --yes ppa:obsproject/obs-studio && \
        sudo apt-get install ${apt_args} ${_build_packages} obs-studio && break
      (( attempt < 5 )) || return 2
      log_warning "Launchpad request failed (attempt ${attempt}/5), retrying in $(( attempt * 30 ))s"
      sleep $(( attempt * 30 ))
    }
  fi
  log_group
}
